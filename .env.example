# Porta 5433 no host: o Postgres da máquina já usa 5432.
DATABASE_URL=postgresql://app:app@localhost:5433/agentes

# Servidor local de modelos. Troque LLM_MODEL por qwen2.5:3b-instruct
# se uma frase curta passar de cerca de 30 segundos.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text
